# Server Port
PORT=8787

# Allowed Client Origin (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini / AI Studio API Key (Server-Side Only - Keep Secret)
# Obtain your free API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Multimodal AI Model ID (defaults to gemini-3.5-flash)
GOOGLE_MODEL=gemini-3.5-flash
